# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# All vars are NEXT_PUBLIC_* — they ship to the browser by design (no backend of our own).

# --- site metadata (optional; used as Open Graph metadataBase, falls back to localhost) ---
NEXT_PUBLIC_SITE_URL=

# --- chain wiring (written by deploy.sh; testnet defaults shown) ---
NEXT_PUBLIC_NETWORK=TESTNET
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_CONTRACT_ID=<fresh contract id>
NEXT_PUBLIC_TOKEN_ID=<the IDR-stand-in SAC address>
NEXT_PUBLIC_EXPLORER_BASE=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_ADMIN_ADDRESS=<the operator public key>
NEXT_PUBLIC_ATTESTER_ADDRESS=<attester public key>
NEXT_PUBLIC_CURATOR_ADDRESS=<curator public key>

# --- IPFS image pinning — needed for real /campaign/new uploads ---
# Gateway is used read-side to resolve on-chain CIDs; JWT is used write-side to pin.
# Use a scoped, pin-only Pinata JWT — it is client-visible, so keep its permissions minimal.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_PINATA_JWT=<a scoped/short-lived Pinata upload JWT — client-visible, keep it scoped>

# --- testnet anchor — needed for real SEP-10/SEP-12 on /verify (opt-in) ---
# Without these, /verify falls back to the labeled simulated attest.
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=<anchor's domain, for stellar.toml discovery>
NEXT_PUBLIC_ANCHOR_AUTH_ENDPOINT=<optional explicit SEP-10 WEB_AUTH_ENDPOINT override>

# --- attester service (SERVER-ONLY!) — auto-writes the on-chain tier after the anchor accepts KYC ---
# NOT NEXT_PUBLIC_: this secret key must never ship to the browser. It powers /api/attest, which
# re-confirms KYC with the anchor and then signs set_verification. In production this is replaced by a
# KMS/HSM-backed signer — the raw key never sits in an env var. Its pubkey must equal
# NEXT_PUBLIC_ATTESTER_ADDRESS, and the account must be funded on the target network (it pays fees).
ATTESTER_SECRET=<the attester's secret key S… — server-only, git-ignored, KMS in prod>
